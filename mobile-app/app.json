{
  "expo": {
    "name": "GeoApp",
    "slug": "geoapp",
    "version": "1.1",
    "orientation": "portrait",
    "icon": "./assets/iconENLA.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Esta aplicación requiere acceso a tu ubicación para registrar tu trayecto de asistencia.",
          "locationWhenInUsePermission": "Esta aplicación requiere acceso a tu ubicación mientras la utilizas.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-image-picker",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/iconENLA.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación requiere acceso a tu ubicación para registrar tus visitas a las sedes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Esta aplicación requiere acceso constante a tu ubicación en segundo plano para registrar tu trayecto de asistencia a la sede.",
        "NSLocationAlwaysUsageDescription": "Esta aplicación requiere acceso constante a tu ubicación en segundo plano para registrar tu trayecto de asistencia a la sede.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.geoapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/iconENLA.png",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBO4eUI_vqwvcLTfCmai2-YqSnx-2E1N1c"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "162dcb07-1537-4e98-abaa-33218aee0a16"
      }
    }
  }
}
